# ---- Sarvam ----
SARVAM_API_KEY=

# ---- Database ----
# Dev default is SQLite (no setup). For prod use the Supabase/Postgres URL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/maxfly
DATABASE_URL=sqlite:///./maxfly.sqlite3

# ---- Redis / Celery ----
# Leave empty to run tasks synchronously (eager mode, no broker needed).
REDIS_URL=

# ---- Storage ----
# local | supabase | r2
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data

# ---- Supabase (optional) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
SUPABASE_JWT_SECRET=

# ---- Cloudflare R2 (optional) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- App ----
CORS_ORIGINS=http://localhost:5173

# Optional AI denoise model (.rnnn) for stronger "Enhance audio" (else ffmpeg afftdn is used)
ARNNDN_MODEL_PATH=

# Auth: set true to require Supabase login (leave SUPABASE_JWT_SECRET blank to verify via JWKS)
AUTH_ENABLED=false

# Payments (leave blank = mock mode; add Razorpay TEST keys to trial real checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
